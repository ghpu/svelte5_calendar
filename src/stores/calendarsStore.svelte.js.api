import { calendarApi } from '../services/api.js'
import { transformCalendarFromApi, transformCalendarToApi } from '../utils/dataTransformer.js'

// Calendars store with Svelte 5 runes - API version (fully synced with latest fixes)
class CalendarsStore {
  calendars = $state([])
  loading = $state(false)
  error = $state(null)

  constructor() {
    this.loadCalendars()
  }

  async loadCalendars() {
    try {
      this.loading = true
      this.error = null
      const apiCalendars = await calendarApi.getAll()
      this.calendars = apiCalendars.map(transformCalendarFromApi)
    } catch (err) {
      this.error = err.message
      console.error('Failed to load calendars:', err)
    } finally {
      this.loading = false
    }
  }

  async addCalendar(name, color) {
    try {
      this.loading = true
      this.error = null

      const calendarData = {
        name,
        color,
        visible: true,
        is_default: false
      }

      const apiCalendar = await calendarApi.create(calendarData)
      const newCalendar = transformCalendarFromApi(apiCalendar)
      this.calendars.push(newCalendar)
      return newCalendar
    } catch (err) {
      this.error = err.message
      console.error('Failed to add calendar:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async updateCalendar(id, updates) {
    try {
      this.loading = true
      this.error = null

      const updateData = transformCalendarToApi(updates)
      const apiCalendar = await calendarApi.update(id, updateData)
      const updatedCalendar = transformCalendarFromApi(apiCalendar)

      const index = this.calendars.findIndex(c => c.id === id)
      if (index !== -1) {
        // Proper Svelte 5 reactivity: reassign the array
        this.calendars = [
          ...this.calendars.slice(0, index),
          { ...this.calendars[index], ...updatedCalendar },
          ...this.calendars.slice(index + 1)
        ]
      }
    } catch (err) {
      this.error = err.message
      console.error('Failed to update calendar:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async deleteCalendar(id) {
    try {
      const calendar = this.calendars.find(c => c.id === id)
      if (calendar && !calendar.isDefault) {
        this.loading = true
        this.error = null

        await calendarApi.delete(id)
        this.calendars = this.calendars.filter(c => c.id !== id)
        return true
      }
      return false
    } catch (err) {
      this.error = err.message
      console.error('Failed to delete calendar:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async toggleCalendar(id) {
    const calendar = this.calendars.find(c => c.id === id)
    if (calendar) {
      await this.updateCalendar(id, { visible: !calendar.visible })
    }
  }

  getVisibleCalendarIds() {
    return this.calendars.filter(c => c.visible).map(c => c.id)
  }

  getCalendar(id) {
    return this.calendars.find(c => c.id === id)
  }

  getDefaultCalendar() {
    return this.calendars.find(c => c.isDefault) || this.calendars[0] || {
      id: 'default',
      name: 'Default',
      color: '#3b82f6',
      visible: true,
      isDefault: true
    }
  }
}

export const calendarsStore = new CalendarsStore()
