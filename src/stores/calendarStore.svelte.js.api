import {
  addMonths,
  subMonths,
  addWeeks,
  subWeeks,
  addDays,
  subDays,
  startOfDay,
  endOfDay
} from 'date-fns'
import { getAllEventInstancesInRange } from '../utils/recurringEvents.js'
import { calendarsStore } from './calendarsStore.svelte.js'
import { eventApi } from '../services/api.js'
import { transformEventFromApi, transformEventToApi } from '../utils/dataTransformer.js'

// Event store with Svelte 5 runes - API version (fully synced with latest features)
class CalendarStore {
  currentDate = $state(new Date())
  view = $state('month')
  events = $state([])
  eventsVersion = $state(0)
  selectedEvent = $state(null)
  showEventModal = $state(false)
  searchQuery = $state('')
  selectedCategories = $state([])
  timezone = $state(Intl.DateTimeFormat().resolvedOptions().timeZone)
  loading = $state(false)
  error = $state(null)

  constructor() {
    this.loadEvents()
  }

  async loadEvents() {
    try {
      this.loading = true
      this.error = null
      const apiEvents = await eventApi.getAll()
      this.events = apiEvents.map(transformEventFromApi)
      this.eventsVersion++
    } catch (err) {
      this.error = err.message
      console.error('Failed to load events:', err)
    } finally {
      this.loading = false
    }
  }

  nextPeriod() {
    if (this.view === 'month') this.currentDate = addMonths(this.currentDate, 1)
    else if (this.view === 'week') this.currentDate = addWeeks(this.currentDate, 1)
    else if (this.view === 'day') this.currentDate = addDays(this.currentDate, 1)
  }

  prevPeriod() {
    if (this.view === 'month') this.currentDate = subMonths(this.currentDate, 1)
    else if (this.view === 'week') this.currentDate = subWeeks(this.currentDate, 1)
    else if (this.view === 'day') this.currentDate = subDays(this.currentDate, 1)
  }

  goToToday() {
    this.currentDate = new Date()
  }

  setCurrentDate(date) {
    this.currentDate = date
  }

  setView(view) {
    this.view = view
  }

  async addEvent(event) {
    try {
      this.loading = true
      this.error = null
      const eventData = transformEventToApi(event)
      eventData.calendar_id = eventData.calendar_id || calendarsStore.getDefaultCalendar().id
      const apiEvent = await eventApi.create(eventData)
      const newEvent = transformEventFromApi(apiEvent)
      this.events.push(newEvent)
      this.eventsVersion++
      return newEvent
    } catch (err) {
      this.error = err.message
      console.error('Failed to add event:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async updateEvent(id, updates) {
    try {
      this.loading = true
      this.error = null
      const eventData = transformEventToApi(updates)
      const apiEvent = await eventApi.update(id, eventData)
      const updatedEvent = transformEventFromApi(apiEvent)
      const index = this.events.findIndex(e => e.id === id)
      if (index !== -1) {
        this.events[index] = { ...this.events[index], ...updatedEvent }
        this.eventsVersion++
      }
    } catch (err) {
      this.error = err.message
      console.error('Failed to update event:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async deleteEvent(id) {
    try {
      this.loading = true
      this.error = null
      await eventApi.delete(id)
      this.events = this.events.filter(e => e.id !== id)
      this.eventsVersion++
    } catch (err) {
      this.error = err.message
      console.error('Failed to delete event:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  isRecurringInstance(event) {
    return event && event.isRecurring && event.recurringParentId
  }

  getParentEvent(instanceId) {
    const parentId = instanceId.split('_')[0]
    return this.events.find(e => e.id === parentId)
  }

  async editRecurringSeries(instanceId, updates) {
    const parentId = instanceId.split('_')[0]
    await this.updateEvent(parentId, updates)
  }

  async editRecurringInstance(instance, updates) {
    const exceptionEvent = {
      ...instance,
      ...updates,
      isRecurring: false,
      isException: true,
      originalEventId: instance.recurringParentId,
      exceptionDate: instance.instanceDate
    }
    delete exceptionEvent.id

    try {
      this.loading = true
      this.error = null
      const eventData = transformEventToApi(exceptionEvent)
      eventData.is_exception = true
      eventData.original_event_id = instance.recurringParentId
      eventData.exception_date = instance.instanceDate
      const apiEvent = await eventApi.create(eventData)
      const newEvent = transformEventFromApi(apiEvent)
      this.events.push(newEvent)
      this.eventsVersion++
      return newEvent
    } catch (err) {
      this.error = err.message
      console.error('Failed to edit recurring instance:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async deleteRecurringSeries(instanceId) {
    const parentId = instanceId.split('_')[0]
    await this.deleteEvent(parentId)
  }

  async deleteRecurringInstance(instance) {
    const deletionException = {
      title: instance.title,
      startDate: instance.startDate,
      endDate: instance.endDate,
      calendarId: instance.calendarId,
      category: instance.category,
      isDeleted: true,
      originalEventId: instance.recurringParentId,
      exceptionDate: instance.instanceDate
    }

    try {
      this.loading = true
      this.error = null
      const eventData = transformEventToApi(deletionException)
      eventData.is_deleted = true
      eventData.original_event_id = instance.recurringParentId
      eventData.exception_date = instance.instanceDate
      const apiEvent = await eventApi.create(eventData)
      const newEvent = transformEventFromApi(apiEvent)
      this.events.push(newEvent)
      this.eventsVersion++
    } catch (err) {
      this.error = err.message
      console.error('Failed to delete recurring instance:', err)
      throw err
    } finally {
      this.loading = false
    }
  }

  async duplicateEvent(event) {
    const duplicated = { ...event, title: `${event.title} (Copy)` }
    delete duplicated.id
    delete duplicated.createdAt
    delete duplicated.updatedAt
    delete duplicated.isException
    delete duplicated.isDeleted
    delete duplicated.originalEventId
    delete duplicated.exceptionDate
    return await this.addEvent(duplicated)
  }

  async changeEventCategory(id, categoryId) {
    await this.updateEvent(id, { category: categoryId })
  }

  async changeEventStatus(id, status) {
    await this.updateEvent(id, { status })
  }

  async changeEventPriority(id, priority) {
    await this.updateEvent(id, { priority })
  }

  getEventsForDate(date) {
    const dateStart = startOfDay(date)
    const dateEnd = endOfDay(date)
    return getAllEventInstancesInRange(this.filteredEvents, dateStart, dateEnd)
  }

  openEventModal(event = null) {
    this.selectedEvent = event
    this.showEventModal = true
  }

  closeEventModal() {
    this.selectedEvent = null
    this.showEventModal = false
  }

  setSearchQuery(query) {
    this.searchQuery = query
  }

  toggleCategory(category) {
    const index = this.selectedCategories.indexOf(category)
    if (index > -1) {
      this.selectedCategories.splice(index, 1)
    } else {
      this.selectedCategories.push(category)
    }
  }

  get filteredEvents() {
    let filtered = this.events
    const visibleCalendarIds = calendarsStore.getVisibleCalendarIds()
    const defaultCalendarId = calendarsStore.getDefaultCalendar().id
    filtered = filtered.filter(event => {
      const calendarId = event.calendarId || defaultCalendarId
      return visibleCalendarIds.includes(calendarId)
    })

    if (this.searchQuery) {
      const query = this.searchQuery.toLowerCase()
      filtered = filtered.filter(event =>
        event.title.toLowerCase().includes(query) ||
        event.description?.toLowerCase().includes(query) ||
        event.location?.toLowerCase().includes(query)
      )
    }

    if (this.selectedCategories.length > 0) {
      filtered = filtered.filter(event =>
        this.selectedCategories.includes(event.category)
      )
    }

    return filtered
  }

  exportToICal() {
    let ical = 'BEGIN:VCALENDAR\\nVERSION:2.0\\nPRODID:-//Calendar Pro//EN\\n'
    this.events.forEach(event => {
      ical += 'BEGIN:VEVENT\\n'
      ical += `UID:${event.id}\\n`
      ical += `SUMMARY:${event.title}\\n`
      if (event.description) ical += `DESCRIPTION:${event.description}\\n`
      if (event.location) ical += `LOCATION:${event.location}\\n`
      ical += 'END:VEVENT\\n'
    })
    ical += 'END:VCALENDAR'
    const blob = new Blob([ical], { type: 'text/calendar' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = 'calendar.ics'
    a.click()
    URL.revokeObjectURL(url)
  }

  async importFromICal(file) {
    const text = await file.text()
    console.log('iCal import in API mode:', text)
    alert('iCal import in API mode - send to backend API')
  }
}

export const calendarStore = new CalendarStore()
